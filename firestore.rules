rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'andresmisel@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isFamilyMember(familyId) {
      return isSignedIn() && (
        isAdmin() ||
        (
          exists(/databases/$(database)/documents/families/$(familyId)) &&
          request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberUids
        )
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
        request.resource.data.email is string &&
        request.resource.data.displayName is string;
      allow delete: if isAdmin();
    }

    // Families
    match /families/{familyId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (resource.data.createdBy == request.auth.uid) ||
        (request.auth.uid in resource.data.memberUids)
      );
      
      allow create: if isSignedIn() && isValidId(familyId) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.babyName is string &&
        request.resource.data.babyName.size() <= 100;

      allow update: if isSignedIn() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.memberUids
      );

      allow delete: if isSignedIn() && (
        isAdmin() || resource.data.createdBy == request.auth.uid
      );

      // Feedings subcollection
      match /feedings/{feedingId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && isValidId(feedingId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.loggedByUid == request.auth.uid;
        allow update: if isFamilyMember(familyId) &&
          (resource.data.loggedByUid == request.auth.uid || isAdmin());
        allow delete: if isFamilyMember(familyId) &&
          (resource.data.loggedByUid == request.auth.uid || isAdmin());
      }

      // Diapers subcollection
      match /diapers/{diaperId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && isValidId(diaperId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.loggedByUid == request.auth.uid;
        allow update: if isFamilyMember(familyId) &&
          (resource.data.loggedByUid == request.auth.uid || isAdmin());
        allow delete: if isFamilyMember(familyId) &&
          (resource.data.loggedByUid == request.auth.uid || isAdmin());
      }

      // Sleeps subcollection
      match /sleeps/{sleepId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && isValidId(sleepId) &&
          request.resource.data.familyId == familyId &&
          request.resource.data.loggedByUid == request.auth.uid;
        allow update: if isFamilyMember(familyId) &&
          (resource.data.loggedByUid == request.auth.uid || isAdmin());
        allow delete: if isFamilyMember(familyId) &&
          (resource.data.loggedByUid == request.auth.uid || isAdmin());
      }

      // Inventory subcollection
      match /inventory/{itemId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && isValidId(itemId) &&
          request.resource.data.familyId == familyId;
        allow update: if isFamilyMember(familyId);
        allow delete: if isFamilyMember(familyId);
      }

      // Medical appointments and vaccines
      match /medical/{recordId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId) && isValidId(recordId) &&
          request.resource.data.familyId == familyId;
        allow update: if isFamilyMember(familyId);
        allow delete: if isFamilyMember(familyId);
      }
    }
  }
}
