rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Families and all subcollections (feedings, diapers, sleeps, inventory, medical, reminders)
    // Synchronize seamlessly across all devices without requiring login
    match /families/{familyId} {
      allow read, write: if true;

      match /{subcollection=**} {
        allow read, write: if true;
      }
    }

    // Default deny for other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
